# =============================================================================
# SHOPCART BACKEND - VARIABLES DE ENTORNO (.env.example)
# =============================================================================

# Puerto del servidor HTTP
PORT=4000

# --- Configuración de Microsoft SQL Server (mssql) ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=shop_cart_db
DB_USER=sa
DB_PASSWORD=your_sql_server_password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# URL del Frontend permitido para CORS
FRONTEND_URL=http://localhost:8001

# --- Configuración de JWT (jose) ---
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_ISS="https://api.shopcart.com"
JWT_AUD="https://shopcart.com"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Firebase Admin SDK (opcional) ---
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Cloudflare R2 Storage ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
R2_ENDPOINT=""

# --- Resend & OTP ---
RESEND_API_KEY=""
OTP_PROVIDER=""
OTP_URL=http://localhost:8000/api/v1/
